+# Lucaryin fold (0034): a directory listing bigger than this is not scanned for a variant.
+_VARIANT_SCAN_MAX_ENTRIES = 5000
+
+
+def _canonical_name(name: str) -> str:
+    try:
+        from tools.file_operations import canonical_filename
+        return canonical_filename(name)
+    except Exception:  # noqa: BLE001 — same folding, without the read tools
+        import unicodedata
+        out = unicodedata.normalize("NFC", name)
+        for src, dst in (("\u202f", " "), ("\u00a0", " "), ("\u2019", "'"), ("\u2018", "'")):
+            out = out.replace(src, dst)
+        return out.strip()
+
+
+def _unicode_variant_on_disk(path: Path) -> Optional[Path]:
+    """The one entry in ``path``'s directory whose name is unicode-equivalent to ``path``'s
+    (NFC/NFD, narrow/no-break spaces, curly quotes, edge whitespace), else None. Several
+    candidates = a homoglyph collision: guessing could open the wrong file, so none."""
+    try:
+        parent, name = path.parent, path.name
+        if not name or not parent.is_dir():
+            return None
+        want = _canonical_name(name)
+        matches = []
+        with os.scandir(parent) as entries:
+            for n, entry in enumerate(entries):
+                if n >= _VARIANT_SCAN_MAX_ENTRIES:
+                    return None
+                if entry.name != name and _canonical_name(entry.name) == want:
+                    matches.append(entry.name)
+        return parent / matches[0] if len(matches) == 1 else None
+    except OSError:
+        return None
+
+
