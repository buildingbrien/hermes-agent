+def is_lucaryin_deliver_token(part: str) -> bool:
+    """Lucaryin fold (patch 0023): ``lucaryin`` / ``lucaryin:<session_id>`` (case-insensitive) — a
+    deliver element the state.db lane serves; preflight must not demand a connected gateway for it."""
+    return str(part or "").strip().split(":", 1)[0].strip().lower() == LUCARYIN_PLATFORM
