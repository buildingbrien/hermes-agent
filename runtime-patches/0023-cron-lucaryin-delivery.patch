+def _lucaryin_store_path() -> Optional[Any]:
+    """Lucaryin fold (patch 0023): the ``SessionDB`` default state.db path (a ``pathlib.Path``) when
+    the store exists on this host, else None. Resolved WITHOUT opening a ``SessionDB`` — that would
+    create an empty state.db on a plain hermes-agent host — and shared by the read-only session
+    lookup and the delivery write so neither can conjure a store."""
+    try:
+        from hermes_state import _default_db_path
+        db_path = _default_db_path()
+    except Exception:  # noqa: BLE001 — no store here; not a Lucaryin host
+        return None
+    return db_path if os.path.exists(db_path) else None
+
