+def _deliver_to_lucaryin_session(job: dict, session_id: str, content: str) -> Optional[str]:
+    """Lucaryin fold (patch 0023): deliver cron output into a Lucaryin chat thread by writing it
+    to state.db.
+
+    The "lucaryin" platform is not a messenger — the target ``chat_id`` IS a
+    ``hermes_state.SessionDB`` session id, and the Lucaryin app renders that session from
+    ~/.hermes/state.db. So the run output is appended as an assistant message on that session;
+    the desktop app shows it when the thread reloads. A session id that is not in the store is an
+    error (the conversation was deleted, or a hand-edited job): failing loudly beats delivering
+    to nobody with last_status "ok". A host with no store at all is the same error, decided before
+    a writable ``SessionDB`` is opened (opening one would create an empty state.db).
+
+    Mobile is a second surface: it only mirrors state.db via hub_sync, and the node's hub_sync
+    poller is not always running (a chat turn triggers a fast-flush, but a cron run has no turn).
+    So a best-effort flush hint is dropped — ``<HERMES_HOME>/cron/.pending_hub_flush``, one
+    session id per line — which the Lucaryin bridge's cron ticker drains and flushes. On a plain
+    hermes-agent host no lucaryin target ever resolves, so the hint is never written. Returns
+    None on success, or an error string.
+    """
+    job_id = job.get("id", "?")
+    session_id = str(session_id or "").strip()
+    if not session_id:
+        return "lucaryin delivery has no session id (origin chat_id missing)"
+    if _lucaryin_store_path() is None:
+        logger.warning(
+            "Job '%s': lucaryin delivery target session %s: no state.db on this host",
+            job_id, session_id)
+        return f"lucaryin delivery target session {session_id} not found: no state.db on this host"
+    try:
+        from hermes_state import SessionDB
+        with SessionDB() as db:
+            if db.get_session(session_id) is None:
+                logger.warning(
+                    "Job '%s': lucaryin delivery target session %s is not in state.db",
+                    job_id, session_id)
+                return f"lucaryin delivery target session {session_id} not found in state.db"
+            db.append_message(session_id=session_id, role="assistant", content=content)
+    except Exception as e:  # pragma: no cover — defensive
+        logger.error("Job '%s': lucaryin state.db write failed: %s", job_id, e)
+        return f"lucaryin delivery failed: {e}"
+    logger.info("Job '%s': delivered into Lucaryin session %s", job_id, session_id)
+
+    # Best-effort flush hint (see docstring). Never fails the delivery.
+    try:
+        from hermes_constants import get_hermes_home  # same helper SessionDB uses
+        hint_dir = get_hermes_home() / "cron"
+        hint_dir.mkdir(parents=True, exist_ok=True)
+        with open(hint_dir / ".pending_hub_flush", "a", encoding="utf-8") as fh:
+            fh.write(f"{session_id}\n")
+    except Exception:  # pragma: no cover — hint is optional
+        logger.debug("Job '%s': could not write the lucaryin hub-flush hint", job_id, exc_info=True)
+    return None
+
