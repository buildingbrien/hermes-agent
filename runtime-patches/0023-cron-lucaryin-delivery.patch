+def _lucaryin_target(session_id: str, resolved_from: Optional[str] = None) -> dict:
+    """Delivery target for a Lucaryin chat session (``chat_id`` IS the ``hermes_state`` session id)."""
+    target = {"platform": LUCARYIN_PLATFORM, "chat_id": str(session_id), "thread_id": None}
+    if resolved_from:
+        target["_resolved_from"] = resolved_from
+    return target
+
