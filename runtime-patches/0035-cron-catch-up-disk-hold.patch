+# ── Lucaryin fold (0035, review of lucaryin-ai#141, F56) ──────────────────────
+# The bridge holds scheduled runs while the computer is almost out of disk space
+# (hermes-bridge/disk_guard.py) and records each hold in <cron dir>/.disk_hold.json =
+# {"holding_since": <epoch or null>, "recent": [{"from", "until"}, ...]}. The app is
+# running then, so no downtime window covers the slot, and the note below used to say
+# the run was late because "the app was closed or the computer was asleep".
+_DISK_HOLD_FILE = ".disk_hold.json"
+
+
+def _disk_hold_covering(due_ts: float, now: Optional[float] = None) -> Optional[tuple]:
+    """The recorded disk hold that covers ``due_ts`` (a hold still in force ends now), or None."""
+    import time as _time
+    try:
+        from cron.jobs import _current_cron_store
+        raw = json.loads((_current_cron_store().cron_dir / _DISK_HOLD_FILE).read_text(encoding="utf-8"))
+    except Exception:
+        return None
+    if not isinstance(raw, dict):
+        return None
+    windows = []
+    for w in raw.get("recent") if isinstance(raw.get("recent"), list) else []:
+        try:
+            windows.append((float(w["from"]), float(w["until"])))
+        except Exception:
+            continue
+    try:
+        if raw.get("holding_since") is not None:
+            windows.append((float(raw["holding_since"]), float(now if now is not None else _time.time())))
+    except (TypeError, ValueError):
+        pass
+    for start, end in windows:
+        if end > start and start - _DOWNTIME_START_SLACK_SECONDS <= due_ts <= end:
+            return (start, end)
+    return None
+
+
