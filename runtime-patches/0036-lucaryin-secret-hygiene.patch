+def _existing_text(path: str, task_id: str) -> str:
+    """The current text of a local file about to be overwritten ('' when
+    absent, unreadable or too large)."""
+    try:
+        resolved = _resolve_or_none(path, task_id) or os.path.expanduser(path)
+        if not os.path.isfile(resolved) or os.path.getsize(resolved) > _SENTINEL_CHECK_MAX_BYTES:
+            return ""
+        with open(resolved, encoding="utf-8", errors="replace") as fh:
+            return fh.read()
+    except Exception:
