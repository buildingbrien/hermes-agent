+def _lucaryin_session_material_refusal(action: str, args: Any) -> Optional[str]:
+    """Lucaryin fold (0009): the JSON refusal for a browser_cdp / browser_console
+    call that reaches browser session material (tools/session_material_policy.py),
+    else None. The policy module ships with the runtime; if it cannot load, those
+    two actions fail closed."""
+    if action not in ("browser_cdp", "browser_console"):
+        return None
+    a = args if isinstance(args, dict) else {}
+    if action == "browser_console" and a.get("expression") is None:
+        return None
+    try:
+        from tools import session_material_policy as smp
+    except Exception:  # noqa: BLE001
+        reason = "Blocked: the browser session-material policy is unavailable."
+    else:
+        reason = (smp.cdp_refusal(a.get("method", ""), a.get("params")) if action == "browser_cdp"
+                  else smp.js_refusal(a.get("expression")))
+    if reason is None:
+        return None
+    return json.dumps({"success": False, "error": reason, "blocked": "session_material"})
+
