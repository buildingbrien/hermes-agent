+# Lucaryin fold (0033, F37): indexes an older Lucaryin runtime created and nothing in this
+# schema owns. The pre-rebase v4.6.87 runtime (schema v7, "stop double-writing tool-result
+# rows") added a partial UNIQUE index on messages(session_id, tool_call_id) with no ``active``
+# filter. In-place compaction (archive_and_compact) soft-archives the active rows and re-inserts
+# the carried tail under the SAME session id with the SAME tool_call_ids, so on every state.db
+# that ever ran that build the compaction transaction hits "UNIQUE constraint failed:
+# messages.session_id, messages.tool_call_id", rolls back, and a long session never shrinks.
+# The rebased runtime never creates it, so dropping it restores upstream's shape exactly.
+_STALE_LUCARYIN_INDEXES = ("idx_messages_tool_result_unique",)
+
+
+def _drop_stale_lucaryin_indexes(cursor: sqlite3.Cursor) -> None:
+    """Drop the leftover indexes above. Probe first: DROP INDEX takes the write lock even
+    when the index is absent, and this runs on every open (see the NULL-``active`` heal)."""
+    for name in _STALE_LUCARYIN_INDEXES:
+        try:
+            present = cursor.execute(
+                "SELECT 1 FROM sqlite_master WHERE type = 'index' AND name = ? LIMIT 1", (name,)
+            ).fetchone()
+            if present is None:
+                continue
+            cursor.execute(f"DROP INDEX IF EXISTS {_q(name)}")
+            logger.warning("Dropped stale index %s left by an older Lucaryin runtime "
+                           "(it made in-place compaction fail with a UNIQUE error)", name)
+        except sqlite3.Error as exc:
+            # Never abort opening the DB over this; compaction keeps failing loudly instead.
+            logger.warning("Could not drop stale index %s: %s", name, exc)
 
 
