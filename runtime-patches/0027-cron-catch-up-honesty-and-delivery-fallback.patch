+        raw = json.loads((_current_cron_store().cron_dir / _DOWNTIME_FILE).read_text(encoding="utf-8"))
+    except Exception:
+        return []
+    if not isinstance(raw, dict):
+        return []
+    entries = [raw] + [w for w in (raw.get("recent") if isinstance(raw.get("recent"), list) else [])]
+    windows = []
+    for w in entries:
+        try:
+            start, end = float(w["from"]), float(w["until"])
+        except Exception:
+            continue
