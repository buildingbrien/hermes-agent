 from tools import browser_tool_lightpanda_fallback as _lp
 
 
+# ===========================================================================
+# Lucaryin UI-access: the signed-in "team browser" as a third CDP-override tier
+# ===========================================================================
+# Upstream ``_cdp._get_cdp_override()`` resolves BROWSER_CDP_URL / browser.cdp_url
+# / real-profile only. Lucaryin adds a third tier: the user's own signed-in agent
+# browser, discovered on its private CDP port and — when it exists but is closed —
+# relaunched via a local bridge's ``/api/ui-access/open-browser``. This is what
+# makes "sign in to a tool" a real feature: the tools drive the SAME Chrome the
+# user signed into, instead of a cookie-less cloud/stealth browser. Explicit
+# env/config overrides still win (upstream returns them first); the team browser
+# is only discovered when they yield nothing.
+_AGENT_BROWSER_PROFILE = os.path.expanduser(
+    os.path.join(os.environ.get("LUCARYIN_HOME") or "~/.lucaryin", "agent-browser"))
+_AGENT_BROWSER_CDP_PORT = int(os.environ.get("LUCARYIN_CDP_PORT", "9222"))
+# Bridges that can launch the shared agent-browser profile (any one opens it —
+# /api/ui-access/open-browser). Same port map ask_agent uses.
+_BRIDGE_PORTS = (9001, 9005, 9006, 9007)
+
+# Set when the signed-in browser existed but could not be reached/launched, so
+# browser_navigate can surface it instead of silently proceeding cookie-less
+# (#72). NOT sticky: cleared the moment an attach succeeds, so one failed launch
+# can't poison every later navigation with a false "unreachable" warning.
+_SIGNED_IN_BROWSER_UNREACHABLE = False
+
+
+def _mark_signed_in_reachable() -> None:
+    global _SIGNED_IN_BROWSER_UNREACHABLE
+    if _SIGNED_IN_BROWSER_UNREACHABLE:
+        logger.info("signed-in browser reachable again — clearing unreachable flag")
+    _SIGNED_IN_BROWSER_UNREACHABLE = False
+
+
+def _agent_browser_cdp() -> str:
+    """CDP endpoint of the signed-in agent browser, or "" on a machine that has
+    never used one. If the profile exists but the browser is closed, ask a local
+    bridge to launch it. Falling back silently to a DIFFERENT browser would be
+    worse than failing: the agent would report an authwall on a site the user is
+    signed into, which reads as "the feature is broken"."""
+    if not os.path.isdir(_AGENT_BROWSER_PROFILE):
+        return ""
+    import requests  # lazy: keep it off browser_tool's hot import path
+    version_url = f"http://127.0.0.1:{_AGENT_BROWSER_CDP_PORT}/json/version"
+
+    def _ping() -> str:
+        try:
+            payload = requests.get(version_url, timeout=3).json()
+            return str(payload.get("webSocketDebuggerUrl") or "").strip()
+        except Exception:
+            return ""
+
+    ws = _ping()
+    if ws:
+        _mark_signed_in_reachable()
+        return ws  # a /json/version webSocketDebuggerUrl is already a concrete ws:// endpoint
+    # Closed — ask a bridge to bring it up (single launcher lives bridge-side).
+    token = os.environ.get("BRIDGE_AUTH_TOKEN", "")
+    headers = {"Authorization": f"Bearer {token}"} if token else {}
+    for port in _BRIDGE_PORTS:
+        try:
+            requests.post(f"http://127.0.0.1:{port}/api/ui-access/open-browser",
+                          headers=headers, timeout=35)
+        except Exception:
+            continue
+        ws = _ping()
+        if ws:
+            logger.info("agent browser relaunched via bridge :%s", port)
+            _mark_signed_in_reachable()
+            return ws
+    logger.warning(
+        "agent-browser profile exists but the browser could not be reached "
+        "or launched — signed-in sites will be unavailable this turn")
+    global _SIGNED_IN_BROWSER_UNREACHABLE
+    _SIGNED_IN_BROWSER_UNREACHABLE = True
+    return ""
+
+
+# Extend upstream override resolution with the signed-in-browser tier, and install
+# it onto the _cdp module so EVERY consumer that resolves via _cdp._get_cdp_override()
+# at call time (session establishment in browser_tool_session, CDP-supervisor attach
+# in browser_tool_cdp) inherits the fallback without editing browser_tool_cdp.py.
+# _get_cdp_override_raw (pure "is-it-configured" gates) is deliberately NOT wrapped:
+# the team browser is a connect-time discovery, not a configured override.
+# The _lucaryin_upstream stash makes re-import / hot-reload idempotent (no self-wrap).
+_cdp_get_cdp_override_upstream = getattr(
+    _cdp._get_cdp_override, "_lucaryin_upstream", _cdp._get_cdp_override)
+
+
+def _get_cdp_override() -> str:
+    """Resolved CDP override: upstream tiers (env / browser.cdp_url / real-profile),
+    then — only when those yield nothing — the signed-in Lucaryin team browser."""
+    return _cdp_get_cdp_override_upstream() or _agent_browser_cdp()
+
+
+_get_cdp_override._lucaryin_upstream = _cdp_get_cdp_override_upstream  # type: ignore[attr-defined]
+_cdp._get_cdp_override = _get_cdp_override  # type: ignore[assignment]
+
+
