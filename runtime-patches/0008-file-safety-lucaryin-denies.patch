+def _lucaryin_profile_homes() -> list[Path]:
+    """Lucaryin fold (R2-3-13, bug hunt round 2): every profile home under the
+    root, listed at CHECK time. A Lucaryin Mac runs one runtime per agent
+    (thoth, neith, ptah, set, motion ...) as the same OS user, each with its own
+    ``<root>/profiles/<name>``; upstream guards only the ACTIVE home and the
+    root, so one agent's file tools could read a sibling's auth.json / .env /
+    mcp-tokens and rewrite its state.db and sessions with no deny and no card.
+    Listed live (not memoised) so a profile created after import is covered."""
+    try:
+        return sorted(p for p in (_hermes_root_path() / "profiles").iterdir() if p.is_dir())
+    except OSError:
+        return []
+
+
+# Lucaryin fold (HA3 review, 2026-09-23): every deny comparison below goes
+# through _deny_key. macOS's default APFS volume and NTFS are case-insensitive
+# (APFS is normalization-insensitive too), but realpath() keeps whatever case
+# the caller typed, so an exact-string deny was one keystroke away from a
+# bypass: write ~/.hermes/CRON/jobs.json rewrote the real jobs.json, and
+# profiles/NEITH/auth.json read a sibling's keys — the R2-3-02 class again.
+# On those platforms both sides are NFC-normalized and case-folded (and on
+# Windows the trailing dots/spaces Win32 strips from a name are dropped).
+# A case-sensitive volume can only over-block, never under-block.
+_DENY_FOLDS_CASE = sys.platform == "darwin" or os.name == "nt"
+
+# Roots macOS firmlinks from /System/Volumes/Data (/usr/share/firmlinks):
+# /System/Volumes/Data/Users/x IS /Users/x, and realpath() leaves it alone.
+_FIRMLINK_FALLBACK = ("/AppleInternal", "/Applications", "/Library", "/Users", "/Volumes",
+                      "/cores", "/opt", "/pkg", "/private", "/usr/local")
+_firmlink_roots_cache: Optional[tuple] = None
+
+
+def _firmlink_roots() -> tuple:
+    global _firmlink_roots_cache
+    if _firmlink_roots_cache is None:
+        roots = []
+        with suppress(OSError, UnicodeDecodeError):
+            with open("/usr/share/firmlinks", encoding="utf-8") as f:
+                roots = [ln.split("\t", 1)[0].strip() for ln in f if ln.startswith("/")]
+        _firmlink_roots_cache = tuple(r for r in roots if r) or _FIRMLINK_FALLBACK
+    return _firmlink_roots_cache
+
+
+def _deny_text(s: str, *, nt: bool = os.name == "nt", darwin: bool = sys.platform == "darwin") -> str:
+    """The cheap textual aliases, folded before any comparison: on macOS a
+    leading /System/Volumes/Data in front of a firmlinked root; on Windows the
+    \\\\?\\ and \\\\?\\UNC\\ device prefixes (either slash direction)."""
+    if nt:
+        s = s.replace("/", "\\")
+        if s[:8].upper() == "\\\\?\\UNC\\":
+            s = "\\\\" + s[8:]
+        elif s[:4] in ("\\\\?\\", "\\\\.\\"):
+            s = s[4:]
+    elif darwin and s.startswith("/System/Volumes/Data/"):
+        rest = s[len("/System/Volumes/Data"):]
+        if any(rest == r or rest.startswith(r + "/") for r in _firmlink_roots()):
+            s = rest
+    return s
+
+
+def _deny_fold(s: str, *, nt: bool = os.name == "nt", folds: Optional[bool] = None) -> str:
+    """Case / normalization fold of a path or name (see _DENY_FOLDS_CASE)."""
+    if not ((_DENY_FOLDS_CASE if folds is None else folds) or nt):
+        return s
+    if nt:
+        s = "\\".join(part.rstrip(" .") if part not in (".", "..") else part
+                       for part in s.split("\\"))
+    return unicodedata.normalize("NFC", unicodedata.normalize("NFC", s).casefold())
+
+
+def _deny_key(path) -> str:
+    """``path`` in deny-comparison form (see the notes above)."""
+    return _deny_key_of(os.fspath(path), _DENY_FOLDS_CASE)
+
+
+@functools.lru_cache(maxsize=8192)
+def _deny_key_of(s: str, folds: bool) -> str:
+    # One check compares the same few strings ~100 times; the fold is pure.
+    return _deny_fold(_deny_text(s), folds=folds)
+
+
+# Lucaryin fold (HA3 verifier, 2026-09-23): text is not identity. realpath()
+# does not canonicalise every alias of a path — a macOS firmlink spelling the
+# text fold above misses, a hardlinked file, on Windows the \\?\ spellings,
+# \\localhost\C$\ admin shares and 8.3 short names — so every deny below
+# ALSO compares by file identity (st_dev, st_ino; os.path.samestat): the
+# resolved path's existing ancestors are stat'ed once per check, each deny base
+# once per _DENY_STAT_TTL (cached). A base that does not exist yet is compared
+# as (its nearest existing ancestor, the folded rest of its path). A zero
+# st_ino (some network/FAT filesystems on Windows) is no identity at all.
+# A HARDLINKED file (st_nlink > 1) is also matched against the files directly
+# inside a denied directory, for directories small enough to list
+# (_DENY_DIR_SCAN_MAX entries: the auth dir with bridge.token, mcp-tokens/,
+# vault/, cron/); exact-file denies (auth.json, .env, state.db ...) match any
+# hardlink through the identity compare itself.
+_DENY_STAT_TTL = 2.0      # seconds a deny base's stat / listing is reused
+_DENY_CHAIN_TTL = 0.5     # seconds a checked path's ancestor chain is reused
+_DENY_DIR_SCAN_MAX = 256
+_deny_base_ids: dict = {}
+_deny_dir_ids: dict = {}
+_deny_chain_memo: tuple = ("", 0.0, {}, None)
+_deny_path = os.path      # the path flavour the walk splits with (tests swap in ntpath)
+
+
+def _deny_ident(st) -> Optional[tuple]:
+    return (st.st_dev, st.st_ino) if st is not None and st.st_ino else None
+
+
+def _deny_stat(p: str):
+    try:
+        return os.stat(p)
+    except (OSError, ValueError):
+        return None
+
+
+def _deny_walk(p: str, *, all_ancestors: bool):
+    """Yield ``(identity, folded components below it)`` for ``p``'s existing
+    ancestors, deepest first (``p`` itself included); only the nearest one
+    unless ``all_ancestors``."""
+    rest: list = []
+    while True:
+        ident = _deny_ident(_deny_stat(p))
+        if ident is not None:
+            yield ident, tuple(rest)
+            if not all_ancestors:
+                return
+        parent = _deny_path.dirname(p)
+        if not parent or parent == p:
+            return
+        rest.insert(0, _deny_fold(_deny_path.basename(p)))
+        p = parent
+
+
+def _deny_begin_check() -> None:
+    """A public check starts: its path's ancestor chain is stat'ed afresh."""
+    global _deny_chain_memo
+    _deny_chain_memo = ("", 0.0, {}, None)
+
+
+def _deny_chain(resolved) -> tuple:
+    """``({identity: [rest, ...]}, stat of the path itself or None)`` over the
+    checked path's existing ancestors, memoised for the check in progress."""
+    global _deny_chain_memo
+    key, now = os.fspath(resolved), time.monotonic()
+    memo_key, memo_until, memo, own = _deny_chain_memo
+    if memo_key == key and now < memo_until:
+        return memo, own
+    own = _deny_stat(key)
+    chain: dict = {}
+    for ident, rest in _deny_walk(key, all_ancestors=True):
+        chain.setdefault(ident, []).append(rest)
+    _deny_chain_memo = (key, now + _DENY_CHAIN_TTL, chain, own)
+    return chain, own
+
+
+def _deny_dir_members(base) -> frozenset:
+    """Identities of the regular files directly inside ``base`` (cached); empty
+    when it is not a directory or holds more than _DENY_DIR_SCAN_MAX entries."""
+    b = os.fspath(base).rstrip("/\\") or os.fspath(base)
+    now = time.monotonic()
+    hit = _deny_dir_ids.get(b)
+    if hit is not None and now < hit[0]:
+        return hit[1]
+    ids: set = set()
+    try:
+        with os.scandir(b) as it:
+            for n, entry in enumerate(it):
+                if n >= _DENY_DIR_SCAN_MAX:
+                    ids = set()
+                    break
+                with suppress(OSError):
+                    if entry.is_file(follow_symlinks=False):
+                        # os.stat, not entry.stat(): on Windows a DirEntry's
+                        # st_ino / st_dev are always zero.
+                        ident = _deny_ident(os.stat(entry.path, follow_symlinks=False))
+                        if ident is not None:
+                            ids.add(ident)
+    except OSError:
+        ids = set()
+    if len(_deny_dir_ids) > 1024:
+        _deny_dir_ids.clear()
+    out = frozenset(ids)
+    _deny_dir_ids[b] = (now + _DENY_STAT_TTL, out)
+    return out
+
+
+def _deny_base_id(base) -> Optional[tuple]:
+    """``(identity, rest)`` of a deny base's nearest existing ancestor, cached."""
+    b = os.fspath(base)
+    b = b.rstrip("/\\") or b
+    now = time.monotonic()
+    hit = _deny_base_ids.get(b)
+    if hit is not None and now < hit[0]:
+        return hit[1]
+    found = next(_deny_walk(b, all_ancestors=False), None)
+    if len(_deny_base_ids) > 4096:
+        _deny_base_ids.clear()
+    _deny_base_ids[b] = (now + _DENY_STAT_TTL, found)
+    return found
+
+
+def _deny_same_or_under(resolved, base, *, exact: bool) -> bool:
+    """File-identity form of ``resolved == base`` (``exact``) or ``resolved``
+    at/below ``base``."""
+    found = _deny_base_id(base)
+    if found is None:
+        return False
+    chain, own = _deny_chain(resolved)
+    rests = chain.get(found[0])
+    if rests:
+        brest = found[1]
+        if exact:
+            if brest in rests:
+                return True
+        elif any(r[:len(brest)] == brest for r in rests):
+            return True
+    if exact or own is None or own.st_nlink < 2 or not stat.S_ISREG(own.st_mode) or found[1]:
+        return False
+    return _deny_ident(own) in _deny_dir_members(base)
+
+
+def _deny_under(resolved, base) -> bool:
+    """``_is_under`` for the deny checks: equal to ``base`` or below it, compared
+    as ``_deny_key`` strings, then by file identity. (``_is_under`` itself keeps
+    upstream semantics for its other callers — the safe-root check and the
+    container-mirror classifier, which calls ``relative_to`` right after it.)"""
+    r, b = _deny_key(resolved), _deny_key(base)
+    if r == b or r.startswith(b if b.endswith(("/", "\\")) else b + os.sep):
+        return True
+    return _deny_same_or_under(resolved, base, exact=False)
+
+
+def _deny_same_location(a, b) -> bool:
+    """``a`` and ``b`` name the same place (text first, then identity) — for
+    comparing two deny BASES, e.g. the active home with the profile homes."""
+    if _deny_key(a) == _deny_key(b):
+        return True
+    ia = _deny_base_id(a)
+    return ia is not None and ia == _deny_base_id(b)
+
+
+def _deny_in(resolved, candidates) -> bool:
+    """Exact-path membership: ``_deny_key`` strings, then file identity."""
+    candidates = list(candidates)
+    key = _deny_key(resolved)
+    if any(key == _deny_key(c) for c in candidates):
+        return True
+    return any(_deny_same_or_under(resolved, c, exact=True) for c in candidates)
+
+
+def _resolve_child(base, rel: str) -> Optional[str]:
+    """``str((base / rel).resolve())`` for an ALREADY-RESOLVED ``base`` at a fraction
+    of the cost: only ``rel``'s own components are lstat'ed (plain strings, no
+    pathlib), and a symlink among them falls back to a full resolve. A missing
+    component ends the walk (resolve() appends the rest lexically too). With a
+    deny set that is profile-wide this runs ~100 times per check; resolving every
+    candidate in full cost 3.3 ms per check with six profiles (review,
+    2026-09-23). Windows always takes the full resolve (junctions are not
+    S_ISLNK)."""
+    b = os.fspath(base)
+    if os.name == "nt":  # pragma: no cover - Windows
+        return next((str(p) for p in _resolve_each([Path(b) / rel])), None)
+    p = b
+    for part in rel.split(os.sep):
+        p = os.path.join(p, part)
+        try:
+            if stat.S_ISLNK(os.lstat(p).st_mode):
+                return next((str(x) for x in _resolve_each([Path(b) / rel])), None)
+        except OSError:
+            return os.path.join(b, rel)
+    return p
+
+
+def _resolve_children(bases, rel: str) -> list[str]:
+    """``_resolve_child`` for every base, skipping failures."""
+    return [p for p in (_resolve_child(b, rel) for b in bases) if p is not None]
+
