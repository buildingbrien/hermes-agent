+
+def _sibling_private_hit(resolved, hermes_dirs: list[Path], *, files_only: bool = False) -> bool:
+    """True when ``resolved`` is (or, unless ``files_only``, lies inside) a sibling
+    profile's private state (see ``_SIBLING_PRIVATE_FILES``)."""
+    siblings = _lucaryin_sibling_homes(hermes_dirs)
