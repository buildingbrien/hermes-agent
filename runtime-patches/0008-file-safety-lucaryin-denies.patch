+def _lucaryin_sibling_homes(hermes_dirs: list[Path]) -> list[Path]:
+    """``hermes_dirs`` minus the active HERMES_HOME (the root counts as a sibling
+    when a profile is active, and every profile does when the root is)."""
+    active = _resolve_each([_hermes_home_path()])
