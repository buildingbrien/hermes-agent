+    def _local_darwin_env(self) -> bool:
+        """Content search runs on THIS Mac: a ``LocalEnvironment`` on darwin. Test
+        doubles and remote backends keep the upstream command shapes."""
+        from tools.environments.local import LocalEnvironment
+        return sys.platform == "darwin" and isinstance(self.env, LocalEnvironment)
+
+    def _absolute_root(self, path: str) -> str:
+        cwd = getattr(self.env, "cwd", None) or self.cwd
+        return os.path.normpath(path if os.path.isabs(path) else os.path.join(cwd, path))
+
+    def _rg_run_cwd(self, path: str) -> Optional[str]:
+        """Directory rg must run in for root-relative ``--glob`` exclusions to bite,
+        or None when the live cwd already is the root. rg resolves globs against its
+        CWD, not the search root, so ``!Documents/**`` only kept rg out of
+        ``$HOME/Documents`` when the shell happened to sit in ``$HOME`` — from any
+        other cwd it walked straight into Documents/Desktop/Library (unattended TCC
+        prompt, iCloud download). Callers pass the absolute root on the command line
+        so output paths keep their shape."""
+        root = self._absolute_root(path)
+        cwd = getattr(self.env, "cwd", None) or self.cwd
+        return None if root == os.path.normpath(cwd) else root
+
+    def _macos_cloud_synced_root(self, path: str) -> bool:
+        """Whether a local-macOS search root sits at/inside a cloud-synced folder
+        (case-folded: the default APFS volume is case-insensitive)."""
+        if not self._local_darwin_env():
+            return False
+        from tools import file_operations as _fo  # lazy: _HOME is monkeypatched there
+        root = self._absolute_root(path).lower()
+        home = os.path.normpath(_fo._HOME).lower()
+        for dirname in _MACOS_CLOUD_SYNCED_HOME_DIRS:
+            target = os.path.join(home, dirname.lower())
+            if root == target or root.startswith(target + os.sep):
+                return True
+        return False
+
+    def _grep_exclude_dir_args(self, path: str) -> List[str]:
+        """``--exclude-dir=<name>`` for every heavyweight-tree name in the shared scan
+        policy — the rg probes already prune them; the recursive grep read every one
+        (node_modules, venv, .Trash, ...). grep applies --exclude-dir to the
+        command-line root too, so the root's own name is left out."""
+        normalized = os.path.normpath(path or ".")
+        root_name = os.path.basename(
+            getattr(self.env, "cwd", None) or self.cwd) if normalized == "." else os.path.basename(normalized)
+        return [f"--exclude-dir={self._escape_shell_arg(name)}"
+                for name in sorted(SEARCH_PRUNE_DIR_NAMES) if name != root_name]
+
+    def _prune_name_expr(self, root: str) -> str:
+        """find ``\\( -type d \\( -name A -o -name B ... \\) ! -path <root> \\) -prune``
+        for the shared prune policy; the root itself is exempt even when it carries a
+        pruned name (an explicit ``.../build`` search must still search it)."""
+        names = " -o ".join(f"-name {self._escape_shell_arg(name)}" for name in sorted(SEARCH_PRUNE_DIR_NAMES))
+        return f"\\( -type d \\( {names} \\) ! -path {root} \\) -prune"
+
+    @staticmethod
+    def _grep_lane_skip_note(cloud: bool) -> str:
+        """What the find/grep lane never reads. Attached when a search timed out (so
+        "0" is never mistaken for "nothing matches") and on cloud-synced roots (where
+        most entries may be placeholders — 778 of 978 files on the canary Mac)."""
+        skipped = [
+            "binary files",
+            f"files over {_CONTENT_SEARCH_MAX_FILE_MB} MB",
+            "hidden and dependency/build/cache/backup directories (node_modules, venv, .git, ...)",
+        ]
+        if cloud:
+            skipped.append("cloud files not downloaded to this Mac (iCloud/File Provider "
+                           "placeholders — download them in Finder to include them)")
+        return "Content search skipped " + ", ".join(skipped) + "."
