+def _search_timeout_hint(result_dict: dict, target: str = "content") -> str:
+    """Lucaryin fold: honest shape for a search that hit its time limit. The engine
+    stops wherever the deadline caught it, so total_count only covers the part it
+    reached — and 0 there is not "no matches". Tailored by ``target``: a filename
+    search reads nothing, so its advice is about the walk, not file contents."""
+    found = any(result_dict.get(key) for key in ("matches", "matches_text", "files", "counts"))
+    if found:
+        coverage = ("Results are partial: only what was reached before the deadline; "
+                    "paging with offset re-runs the same search to the same point.")
+    else:
+        coverage = ("0 results means nothing matched in the part reached before the "
+                    "deadline — NOT that nothing matches.")
+    if target == "files":
+        return (
+            f"File search timed out before finishing. {coverage} Never searched: whatever "
+            "lies past the deadline, plus what a filename search skips by policy (listed in "
+            "'warning' when it applies: macOS protected folders on a broad root, hidden "
+            "directories, and with ripgrep whatever .gitignore excludes). Narrow 'path' to one "
+            "folder or use a more specific name pattern (e.g. 'invoice*.pdf').")
+    return (
+        f"Search timed out before finishing. {coverage} Never searched: whatever lies "
+        "past the deadline, plus what this search skips by policy (listed in 'warning' "
+        "when it applies: macOS protected folders on a broad root, cloud files not "
+        "downloaded to this Mac, binary files, files over the size cap, hidden and "
+        "dependency/cache directories such as node_modules, venv and .git — never a "
+        "folder merely named backup/build/out/dist/vendor). Narrow 'path' to one folder, add a "
+        "file_glob (e.g. '*.pdf'), or use target='files' for a filename lookup "
+        "(names only, nothing is read).")
