+def canonical_filename(name: str) -> str:
+    """The spelling ``_unicode_variant_match`` compares by: NFC, confusable
+    spaces/quotes collapsed, leading/trailing whitespace dropped (Lucaryin fold,
+    0019). Module-level so the read tools can run the deny list against the
+    spelling a not-found read would be RESCUED to, not only the one requested."""
