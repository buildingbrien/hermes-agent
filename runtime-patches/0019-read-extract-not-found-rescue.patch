+def _read_block_error_any_spelling(resolved) -> str | None:
+    """Lucaryin fold (R2-3-02): the Hermes deny list, evaluated on the requested
+    spelling AND on the spelling the not-found rescue would resolve it to
+    (whitespace / NFC / confusables folded — ``canonical_filename``). The rescue
+    itself re-checks the variant it picks; this belt-and-braces check means a
+    denied store is refused up front, before any directory listing happens."""
+    target = str(resolved)
+    block_error = get_read_block_error(target)
+    if block_error:
+        return block_error
+    base = os.path.basename(target)
+    canon = canonical_filename(base)
+    if canon and canon != base:
+        return get_read_block_error(os.path.join(os.path.dirname(target), canon))
+    return None
 
 
