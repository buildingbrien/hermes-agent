 OUTPUT_DIR = CRON_DIR / "output"
 ONESHOT_GRACE_SECONDS = 120
 
+# ── Lucaryin fold (HA4 / R2-1-43, bug hunt round 2, 2026-09-22) ─────────────
+# The due scan retires a one-shot scanned more than ONESHOT_GRACE_SECONDS past
+# its run time without firing it. On a Lucaryin Mac the bridge ticker runs the
+# due set SERIALLY (HERMES_CRON_MAX_PARALLEL=1, the R2-1-15 stopgap), so one
+# long job makes the tick last the sum of its predecessors' durations and every
+# meeting auto-join or reminder that came due meanwhile was deleted unfired —
+# the user learns the agent never joined when nobody shows up. So a one-shot
+# here gets a late-fire WINDOW instead of the 120 s grace:
+#   * every one-shot: 30 minutes. Nothing marks a "reminder" — the cronjob tool
+#     creates plain prompt one-shots ("remind me at 9:05"), and no writer in the
+#     runtime or the bridge sets type="reminder" — so the window cannot hang off
+#     a type; it is the one-shot default (review, 2026-09-23);
+#   * a meeting_join: until the meeting is over (``meeting.end_iso``, else
+#     start + 30 min), when that is later;
+#   * any writer may pin ``late_fire_window_seconds`` on the record.
+# Clamped to [ONESHOT_GRACE_SECONDS, 6 h]. The create/update/resume checks that
+# reject a schedule already 120 s in the past keep ONESHOT_GRACE_SECONDS. The
+# bridge (hermes-bridge/cron_tick_support.py, B5) alerts in chat on any one-shot
+# a tick retires without a run, and treats 30 min as the widest default window.
+_LATE_FIRE_WINDOW_FIELD = "late_fire_window_seconds"
+_DEFAULT_LATE_FIRE_WINDOW_SECONDS = 30 * 60
+_MAX_LATE_FIRE_WINDOW_SECONDS = 6 * 3600
+
+
+def _oneshot_late_fire_window_seconds(job: Dict[str, Any], next_run_dt: Optional[datetime] = None) -> int:
+    """How late ``job`` (a one-shot) may still fire, in seconds — see the note above."""
+    if not isinstance(job, dict):
+        return _DEFAULT_LATE_FIRE_WINDOW_SECONDS
+    explicit = job.get(_LATE_FIRE_WINDOW_FIELD)
+    if explicit is not None:
+        try:
+            return max(ONESHOT_GRACE_SECONDS, min(int(explicit), _MAX_LATE_FIRE_WINDOW_SECONDS))
+        except (TypeError, ValueError, OverflowError):
+            pass
+    window = _DEFAULT_LATE_FIRE_WINDOW_SECONDS
+    if job.get("type") == "meeting_join":
+        meeting = job.get("meeting") if isinstance(job.get("meeting"), dict) else {}
+        end_dt = _parse_aware(str(meeting.get("end_iso") or "")) if meeting.get("end_iso") else None
+        if end_dt is None and meeting.get("start_iso"):
+            start_dt = _parse_aware(str(meeting.get("start_iso") or ""))
+            if start_dt is not None:
+                end_dt = start_dt + timedelta(seconds=_DEFAULT_LATE_FIRE_WINDOW_SECONDS)
+        if end_dt is not None and next_run_dt is not None:
+            try:
+                window = max(window, int((end_dt - next_run_dt).total_seconds()))
+            except (TypeError, OverflowError):
+                pass
+    return max(ONESHOT_GRACE_SECONDS, min(window, _MAX_LATE_FIRE_WINDOW_SECONDS))
+
 
